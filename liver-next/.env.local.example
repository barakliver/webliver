# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tjdnrktcwzoskvehvslr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key. Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Outgoing mail (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified sender on your domain
MAIL_FROM="Liver Productions <hello@liverproductions.com>"
# Where new lead alerts are delivered
ADMIN_ALERT_EMAIL=barakliver@gmail.com

# ── WhatsApp alerts (any webhook that accepts a JSON POST) ──────────────────
WHATSAPP_WEBHOOK_URL=
WHATSAPP_ALERT_TO=972500000000

# ── Leads arriving from Instagram, Meta, Google Ads, Zapier ─────────────────
# One shared secret for POST /api/leads/webhook. Without it the endpoint
# refuses every delivery, on purpose: an open endpoint fills the leads screen
# with junk, and junk in the one place a producer looks for real enquiries is
# worse than a webhook that is not connected yet.
# Generate one with:  openssl rand -hex 24
# Senders may present it as an x-api-key header, an Authorization: Bearer
# header, a ?key= query parameter, or a google_key body field (Google's lead
# form extension cannot set headers). It doubles as Meta's verify token.
LEAD_WEBHOOK_KEY=

# ── Hero backdrop ───────────────────────────────────────────────────────────
# A file in /public or a full URL. Empty means the hero is the photograph,
# which is what it is today. Drop an MP4 in and set this to switch it on; the
# still stays as the poster and as the fallback for anyone who has asked for
# less motion.
# NEXT_PUBLIC_HERO_VIDEO=/hero.mp4

# ── AI concierge ────────────────────────────────────────────────────────────
# Without a key the widget still answers, politely, by pointing at WhatsApp.
# Every message is a paid API call made by an anonymous visitor, so the route
# rate limits per visitor and caps the day before it calls anything.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5. One line to change if the bill or the
# latency wants a different model.
# ANTHROPIC_MODEL=claude-opus-5

# ── Public site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://liverproductions.com
NEXT_PUBLIC_WHATSAPP_NUMBER=972500000000
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-handle/intro

# ── Sign in code ────────────────────────────────────────────────────────────
# How many digits the code has, how long it is good for, and how long before
# another one may be asked for. All three are Supabase project settings; these
# only tell the screen what to expect. Leave them out unless the project has
# been changed away from the defaults.
# NEXT_PUBLIC_OTP_LENGTH=6
# NEXT_PUBLIC_OTP_TTL_SECONDS=900
# NEXT_PUBLIC_OTP_RESEND_SECONDS=60
